# ebsclone settings: names and addresses only, NEVER passwords.
# The same file goes on the database server, the new apps VM and (when step 05 is used) the source apps host.

# ---------- Database (already exists: we configure it, we do not copy it) ----------
PDB=CHANGEME                       # the PDB the new apps tier will run on (8 characters or fewer: an EBS limit)
CDB_NAME=CHANGEME                  # the container database that holds it
CDB_SID=CHANGEME                   # its instance name on the database server
CDB_UNIQUE=CHANGEME                # its db_unique_name
DB_HOST=CHANGEME                   # database server short host name (no domain)
DB_IP=CHANGEME                     # database server IP address
DB_SCAN=CHANGEME                   # full name the apps tier connects to (SCAN, or the host's full name)
DB_PORT=1521                       # listener port
DB_OH=CHANGEME                     # database Oracle home, e.g. /u01/app/oracle/product/19.0.0.0/dbhome_1
GRID_LISTENER=CHANGEME             # listener.ora that serves the database, e.g. <grid home>/network/admin/listener.ora
OTHER_PDBS=""                      # other PDBs in the same CDB that must stay closed (space separated)
RESTORE_POINT=BEFORE_EBSCLONE      # guaranteed restore point taken before the first change
WORK_DIR=/u01/ebsclone/work        # working folder on the database server

# ---------- Source of the apps files (an apps tier at the SAME code level as the PDB) ----------
SRC_HOST=CHANGEME                  # source apps host (name or IP)
SRC_USER=applmgr                   # apps owner on the source
SRC_BASE=CHANGEME                  # source apps base folder, e.g. /u01/EBSPROD (holds fs1, fs2, fs_ne)

# ---------- Target VM ----------
APPS_HOST=CHANGEME                 # short host name of the target VM (full name must be 30 characters or less)
APPS_IP=CHANGEME                   # its IP address
NET_DOMAIN=CHANGEME                # DNS domain, e.g. example.local
NEW_BASE=CHANGEME                  # new apps base folder, e.g. /u01/EBSTRAIN
PORT_POOL=5                        # web port = 8000 + this
APPS_OWNER=applmgr                 # apps owner on the VM
APPS_GROUP=oinstall                # its group
INV_LOC=/u01/app/oraInventory      # Oracle inventory on the VM
RPM_DIR=/u01/ebsclone/rpms         # optional: offline copy of oracle-ebs-server-R12-preinstall and its dependencies

# ---------- Oracle Linux 8 check files ----------
PATCH_33471111_DIR=/u01/ebsclone/patches/33471111   # unzipped patch 33471111 (Web Tier pre-install check patch)

# ---------- Optional ----------
STALL_MINUTES=20                   # a tool whose log has not grown for this long AND ends on a question is stopped

# ---------- Worked out, do not edit ----------
SERVICE=ebs_${PDB}
WEB_PORT=$((8000 + PORT_POOL))
DB_TAG=${PDB}_${DB_HOST^^}
STATE_DIR=/u01/ebsclone/state
LOG_DIR=/u01/ebsclone/logs
